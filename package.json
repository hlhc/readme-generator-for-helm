{
  "name": "@hlhc/readme-generator-for-helm",
  "version": "4.0.0",
  "description": "Autogenerate READMEs tables and OpenAPI schemas for Helm Charts",
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "bun": ">=1.0.0"
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test-ci": "vitest run --reporter=verbose",
    "lint": "oxlint .",
    "format": "oxfmt 'lib/**/*.ts' 'bin/**/*.ts' 'tests/**/*.ts' 'scripts/*.ts' index.ts vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "bin": {
    "readme-generator": "./dist/bin/index.js"
  },
  "keywords": [
    "README",
    "Helm",
    "Chart",
    "Kubernetes",
    "table",
    "autogenerate"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "commander": "^14.0.3",
    "markdown-table": "^3.0.0",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.10",
    "@types/temp": "^0.9.4",
    "oxfmt": "^0.40.0",
    "oxlint": "^1.52.0",
    "temp": "^0.9.4",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "directories": {
    "lib": "lib",
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hlhc/readme-generator-for-helm.git"
  },
  "author": "Cyrus Ho <hello@cyrusho.me>",
  "bugs": {
    "url": "https://github.com/hlhc/readme-generator-for-helm/issues"
  },
  "homepage": "https://github.com/hlhc/readme-generator-for-helm#readme",
  "packageManager": "bun@1.3.10"
}
