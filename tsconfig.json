{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "lib": ["ESNext"],
    "types": ["bun", "node"],
    "paths": {
      "@lib": ["./lib/index.ts"],
      "@lib/*": ["./lib/*"],
      "@bin": ["./bin/index.ts"],
      "@bin/*": ["./bin/*"],
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
